# ── Anthropic ────────────────────────────────────────────────────────────────
# Claude API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (DALL·E 3 image generation) ───────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Web Search ────────────────────────────────────────────────────────────────
# Brave Search API — https://api.search.brave.com/app/keys (preferred)
BRAVE_SEARCH_API_KEY=BSA...
# Serper.dev fallback — https://serper.dev/api-key (optional, used if Brave key absent)
SERPER_API_KEY=...

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The WhatsApp-enabled Twilio number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Victor's WhatsApp number to receive briefs (format: whatsapp:+61XXXXXXXXX)
VICTOR_WHATSAPP_TO=whatsapp:+61...
# Public URL where the webhook server is deployed (e.g. https://yourapp.railway.app)
WEBHOOK_BASE_URL=https://your-webhook-server.example.com

# ── LinkedIn API ──────────────────────────────────────────────────────────────
# Create an app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
# OAuth 2.0 access token (generated via scripts/linkedin-auth.js)
LINKEDIN_ACCESS_TOKEN=...
# Your LinkedIn Person URN — find at https://www.linkedin.com/in/yourprofile
# Run: node scripts/linkedin-auth.js --whoami after authenticating
LINKEDIN_PERSON_URN=urn:li:person:...

# ── Pipeline behaviour ────────────────────────────────────────────────────────
# Set to "true" to auto-approve and publish without WhatsApp confirmation
AUTO_PUBLISH=false
# Set to "true" to skip actual API calls (use mock data) during development
DRY_RUN=false
# Timezone for scheduling and log timestamps
TZ=Australia/Sydney
# Max retries for agent API calls
MAX_RETRIES=3
